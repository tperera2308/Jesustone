{
  "entities": {
    "AppUser": {
      "title": "AppUser",
      "description": "Registered standard user account in jesustone",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "username": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9._-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "avatarInitials": { "type": "string", "maxLength": 8 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "username", "email", "avatarInitials", "createdAt"]
    },
    "WorshipGroup": {
      "title": "WorshipGroup",
      "description": "Musical and worship band group managed in jesustone",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "leaderUserId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "leaderUserId"]
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "In-app notification for events, songs, mentions, and role assignments",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "recipientUserId": { "type": "string", "maxLength": 128 },
        "groupId": { "type": "string", "maxLength": 128 },
        "groupName": { "type": "string", "maxLength": 120 },
        "category": {
          "type": "string",
          "enum": ["new_event", "new_song", "mention", "role_assigned", "study_published", "group_invite"]
        },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 1000 },
        "actorName": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "targetTab": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "recipientUserId", "groupId", "groupName", "category", "title", "message", "actorName", "createdAt", "targetTab"]
    }
  },
  "firestore": {
    "/jesustone_users/{userId}": {
      "schema": { "$ref": "#/entities/AppUser" },
      "description": "Stores user profiles and accounts for jesustone"
    },
    "/jesustone_groups/{groupId}": {
      "schema": { "$ref": "#/entities/WorshipGroup" },
      "description": "Stores worship groups, events, repertoire songs, studies, and chat messages"
    },
    "/jesustone_notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/AppNotification" },
      "description": "Stores real-time notifications across groups and users"
    }
  }
}
